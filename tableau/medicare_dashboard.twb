            </column>
            <column caption='Showing text' datatype='string' name='[Calculation_3042613585163452]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD(IF [Calculation_5759220639618091] THEN [facility_id] END) = 1 THEN MIN(IF [Calculation_5759220639618091] THEN [Calculation_1033318243903587] END)&#13;&#10;ELSE IIF(COUNTD(IF [Calculation_5759220639618091] THEN [facility_id] END) &gt;= MIN({FIXED : COUNTD(IF [Calculation_9153621850123208] THEN [facility_id] END)}), &quot;all &quot;, &quot;&quot;)&#13;&#10;    + IIF(COUNTD(IF [Calculation_5759220639618091] THEN [facility_id] END) &gt;= 1000,&#13;&#10;          STR(DIV(COUNTD(IF [Calculation_5759220639618091] THEN [facility_id] END), 1000)) + &quot;,&quot; + RIGHT(&quot;00&quot; + STR(COUNTD(IF [Calculation_5759220639618091] THEN [facility_id] END) % 1000), 3),&#13;&#10;          STR(COUNTD(IF [Calculation_5759220639618091] THEN [facility_id] END)))&#13;&#10;    + &quot; hospitals&quot;&#13;&#10;    + IIF(MIN([Calculation_9138364361968688]) &lt;&gt; &quot;All cities&quot;, &quot; in &quot; + MIN([Calculation_9138364361968688]) + &quot;, &quot; + [Parameters].[Parameter 3],&#13;&#10;          IIF([Parameters].[Parameter 3] &lt;&gt; &quot;All states&quot;, &quot; in &quot; + [Parameters].[Parameter 3], &quot;&quot;))&#13;&#10;END' />
            </column>
            <column caption='In the chosen state' datatype='boolean' name='[Calculation_3197067015487477]' role='dimension' type='nominal'>
