          </datasource-dependencies>
          <datasource-dependencies datasource='federated.zd1c0dfae10nuk87uufmozevrbek'>
            <column caption='Penalty $ now' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[Calculation_1115009490449795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1849786399782356] THEN [Calculation_3845773524162689] * [hospital_medicare_payments_usd] END' />
            </column>
            <column caption='Hospital row' datatype='boolean' name='[Calculation_1849786399782356]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[condition_code] = &quot;AMI&quot;' />
            </column>
            <column caption='Money kept note' datatype='string' name='[Calculation_1912012410801314]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(SUM([Calculation_1115009490449795])) THEN &quot;no payment data&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = 0 THEN &quot;move the slider above 0% to test a cut&quot;&#13;&#10;ELSEIF [Calculation_9033902446369652] = 0 AND COUNTD([facility_id]) = 1 AND SUM([Calculation_1115009490449795]) &lt; 1&#13;&#10;    THEN &quot;no change: this hospital has no penalty&quot;&#13;&#10;ELSEIF [Calculation_9033902446369652] = 0 AND COUNTD([facility_id]) = 1 AND ISNULL(MAX([Calculation_3827472772031086]))&#13;&#10;    THEN &quot;no change: no &quot; + ATTR([Calculation_9763411699565876]) + &quot; penalty here&quot;&#13;&#10;ELSEIF [Calculation_9033902446369652] = 0 AND COUNTD([facility_id]) = 1&#13;&#10;    THEN &quot;no change yet: try a bigger cut&quot;&#13;&#10;ELSEIF [Calculation_9033902446369652] = 0 THEN &quot;no hospital&apos;s penalty changes&quot;&#13;&#10;ELSEIF COUNTD([facility_id]) = 1 AND [Calculation_6617884208463837] &gt;= 0.995&#13;&#10;    THEN &quot;this cut ends this hospital&apos;s penalty&quot;&#13;&#10;ELSEIF COUNTD([facility_id]) = 1&#13;&#10;    THEN &quot;this hospital&apos;s penalty drops &quot; + STR(INT(ROUND([Calculation_6617884208463837] * 100, 0))) + &quot;%&quot;&#13;&#10;ELSE IIF([Calculation_9033902446369652] &gt;= 1000, STR(DIV([Calculation_9033902446369652], 1000)) + &quot;,&quot; + RIGHT(&quot;00&quot; + STR([Calculation_9033902446369652] % 1000), 3), STR([Calculation_9033902446369652]))&#13;&#10;    + IIF([Calculation_9033902446369652] = 1, &quot; hospital pays less, &quot;, &quot; hospitals pay less, &quot;)&#13;&#10;    + STR(INT(ROUND([Calculation_6617884208463837] * 100, 0))) + &quot;% off the total&quot;&#13;&#10;END' />
            </column>
            <column caption='In the chosen state' datatype='boolean' name='[Calculation_3197067015487477]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] = &quot;All states&quot; OR [Calculation_3438595070612627] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='State' datatype='string' name='[Calculation_3438595070612627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([state], CASE LEFT([facility_id], 2) WHEN &quot;01&quot; THEN &quot;AL&quot; WHEN &quot;02&quot; THEN &quot;AK&quot; WHEN &quot;03&quot; THEN &quot;AZ&quot; WHEN &quot;04&quot; THEN &quot;AR&quot; WHEN &quot;05&quot; THEN &quot;CA&quot; WHEN &quot;06&quot; THEN &quot;CO&quot; WHEN &quot;07&quot; THEN &quot;CT&quot; WHEN &quot;08&quot; THEN &quot;DE&quot; WHEN &quot;09&quot; THEN &quot;DC&quot; WHEN &quot;10&quot; THEN &quot;FL&quot; WHEN &quot;11&quot; THEN &quot;GA&quot; WHEN &quot;12&quot; THEN &quot;HI&quot; WHEN &quot;13&quot; THEN &quot;ID&quot; WHEN &quot;14&quot; THEN &quot;IL&quot; WHEN &quot;15&quot; THEN &quot;IN&quot; WHEN &quot;16&quot; THEN &quot;IA&quot; WHEN &quot;17&quot; THEN &quot;KS&quot; WHEN &quot;18&quot; THEN &quot;KY&quot; WHEN &quot;19&quot; THEN &quot;LA&quot; WHEN &quot;20&quot; THEN &quot;ME&quot; WHEN &quot;21&quot; THEN &quot;MD&quot; WHEN &quot;22&quot; THEN &quot;MA&quot; WHEN &quot;23&quot; THEN &quot;MI&quot; WHEN &quot;24&quot; THEN &quot;MN&quot; WHEN &quot;25&quot; THEN &quot;MS&quot; WHEN &quot;26&quot; THEN &quot;MO&quot; WHEN &quot;27&quot; THEN &quot;MT&quot; WHEN &quot;28&quot; THEN &quot;NE&quot; WHEN &quot;29&quot; THEN &quot;NV&quot; WHEN &quot;30&quot; THEN &quot;NH&quot; WHEN &quot;31&quot; THEN &quot;NJ&quot; WHEN &quot;32&quot; THEN &quot;NM&quot; WHEN &quot;33&quot; THEN &quot;NY&quot; WHEN &quot;34&quot; THEN &quot;NC&quot; WHEN &quot;35&quot; THEN &quot;ND&quot; WHEN &quot;36&quot; THEN &quot;OH&quot; WHEN &quot;37&quot; THEN &quot;OK&quot; WHEN &quot;38&quot; THEN &quot;OR&quot; WHEN &quot;39&quot; THEN &quot;PA&quot; WHEN &quot;40&quot; THEN &quot;PR&quot; WHEN &quot;41&quot; THEN &quot;RI&quot; WHEN &quot;42&quot; THEN &quot;SC&quot; WHEN &quot;43&quot; THEN &quot;SD&quot; WHEN &quot;44&quot; THEN &quot;TN&quot; WHEN &quot;45&quot; THEN &quot;TX&quot; WHEN &quot;46&quot; THEN &quot;UT&quot; WHEN &quot;47&quot; THEN &quot;VT&quot; WHEN &quot;48&quot; THEN &quot;VI&quot; WHEN &quot;49&quot; THEN &quot;VA&quot; WHEN &quot;50&quot; THEN &quot;WA&quot; WHEN &quot;51&quot; THEN &quot;WV&quot; WHEN &quot;52&quot; THEN &quot;WI&quot; WHEN &quot;53&quot; THEN &quot;WY&quot; END)' />
            </column>
            <column caption='Cut needed for chosen condition' datatype='real' default-format='p0.0%' name='[Calculation_3827472772031086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [counts_toward_penalty] AND ([Parameters].[Parameter 1] = &quot;All conditions&quot; OR [condition] = [Parameters].[Parameter 1])&#13;&#10;THEN [reduction_needed_to_clear] END' />
            </column>
            <column caption='Penalty rate now' datatype='real' default-format='p0.00%' name='[Calculation_3845773524162689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(0.03, {FIXED [facility_id] : SUM([penalty_points])}&#13;&#10;        * {FIXED [facility_id] : MAX([neutrality_modifier])})' />
            </column>
            <column caption='New penalty points' datatype='real' name='[Calculation_4875555720245805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [counts_toward_penalty]&#13;&#10;THEN ZN([payment_share]) * MAX([Calculation_5309434154504009] - [peer_median_ratio], 0)&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='New ratio' datatype='real' name='[Calculation_5309434154504009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[excess_readmission_ratio] * (1 - [Calculation_8232376009799434])' />
