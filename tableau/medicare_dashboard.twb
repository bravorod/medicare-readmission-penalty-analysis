          <datasource-dependencies datasource='federated.zd1c0dfae10nuk87uufmozevrbek'>
            <column caption='Hospital row' datatype='boolean' name='[Calculation_1849786399782356]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[condition_code] = &quot;AMI&quot;' />
            </column>
            <column caption='Where savings stop' datatype='string' name='[Calculation_2086835893140252]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD(IF [Calculation_5759220639618091] THEN [facility_id] END) = 1 THEN&#13;&#10;    IF ISNULL(MAX(IF [Calculation_5759220639618091] AND [counts_toward_penalty] THEN 1 END)) THEN&#13;&#10;        &quot;This hospital has no readmission penalty, so the slider can&apos;t change anything.&quot;&#13;&#10;    ELSEIF ISNULL(MAX(IF [Calculation_5759220639618091] THEN [Calculation_3827472772031086] END)) THEN&#13;&#10;        [Parameters].[Parameter 1] + &quot; isn&apos;t part of this hospital&apos;s penalty, so the slider can&apos;t change it.&quot;&#13;&#10;    ELSE &quot;Savings stop at &quot; + STR(INT(CEILING(MAX(IF [Calculation_5759220639618091] THEN [Calculation_3827472772031086] END) * 100)))&#13;&#10;        + &quot;%. That cut ends this hospital&apos;s &quot; + ATTR([Calculation_9763411699565876]) + &quot; penalty, so going higher won&apos;t change anything.&quot;&#13;&#10;    END&#13;&#10;ELSEIF ISNULL(MAX(IF [Calculation_5759220639618091] AND [counts_toward_penalty] THEN 1 END)) THEN&#13;&#10;    &quot;None of these hospitals are penalized, so the slider can&apos;t change anything.&quot;&#13;&#10;ELSEIF ISNULL([Calculation_4830375413761681]) THEN&#13;&#10;    &quot;None of these hospitals are penalized for &quot; + ATTR([Calculation_9763411699565876]) + &quot;.&quot;&#13;&#10;ELSEIF [Calculation_2191898791070076] = 1 THEN&#13;&#10;    &quot;Only one of these hospitals is penalized&quot;&#13;&#10;    + IIF([Parameters].[Parameter 1] = &quot;All conditions&quot;, &quot;&quot;, &quot; for &quot; + ATTR([Calculation_9763411699565876]))&#13;&#10;    + &quot;, and a cut of &quot; + STR(INT(CEILING([Calculation_4830375413761681] * 100))) + &quot;% ends &quot;&#13;&#10;    + IIF([Parameters].[Parameter 1] = &quot;All conditions&quot;, &quot;it.&quot;, &quot;that penalty.&quot;)&#13;&#10;ELSE IIF([Parameters].[Parameter 1] = &quot;All conditions&quot;, &quot;Half of the penalized hospitals end their whole penalty&quot;,&#13;&#10;          &quot;Half of the hospitals penalized for &quot; + ATTR([Calculation_9763411699565876]) + &quot; end that penalty&quot;)&#13;&#10;    + &quot; with a cut of &quot; + STR(INT(CEILING([Calculation_4830375413761681] * 100))) + &quot;% or less.&quot;&#13;&#10;END' />
            </column>
            <column caption='Hospitals penalized for the chosen condition' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2191898791070076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1] = &quot;All conditions&quot;,&#13;&#10;    COUNTD(IF [Calculation_5759220639618091] AND [Calculation_1849786399782356] AND NOT ISNULL([Calculation_9488607057292462]) THEN [facility_id] END),&#13;&#10;    COUNTD(IF [Calculation_5759220639618091] AND NOT ISNULL([Calculation_3827472772031086]) THEN [facility_id] END))' />
            </column>
            <column caption='In the chosen state' datatype='boolean' name='[Calculation_3197067015487477]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] = &quot;All states&quot; OR [Calculation_3438595070612627] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='State' datatype='string' name='[Calculation_3438595070612627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([state], CASE LEFT([facility_id], 2) WHEN &quot;01&quot; THEN &quot;AL&quot; WHEN &quot;02&quot; THEN &quot;AK&quot; WHEN &quot;03&quot; THEN &quot;AZ&quot; WHEN &quot;04&quot; THEN &quot;AR&quot; WHEN &quot;05&quot; THEN &quot;CA&quot; WHEN &quot;06&quot; THEN &quot;CO&quot; WHEN &quot;07&quot; THEN &quot;CT&quot; WHEN &quot;08&quot; THEN &quot;DE&quot; WHEN &quot;09&quot; THEN &quot;DC&quot; WHEN &quot;10&quot; THEN &quot;FL&quot; WHEN &quot;11&quot; THEN &quot;GA&quot; WHEN &quot;12&quot; THEN &quot;HI&quot; WHEN &quot;13&quot; THEN &quot;ID&quot; WHEN &quot;14&quot; THEN &quot;IL&quot; WHEN &quot;15&quot; THEN &quot;IN&quot; WHEN &quot;16&quot; THEN &quot;IA&quot; WHEN &quot;17&quot; THEN &quot;KS&quot; WHEN &quot;18&quot; THEN &quot;KY&quot; WHEN &quot;19&quot; THEN &quot;LA&quot; WHEN &quot;20&quot; THEN &quot;ME&quot; WHEN &quot;21&quot; THEN &quot;MD&quot; WHEN &quot;22&quot; THEN &quot;MA&quot; WHEN &quot;23&quot; THEN &quot;MI&quot; WHEN &quot;24&quot; THEN &quot;MN&quot; WHEN &quot;25&quot; THEN &quot;MS&quot; WHEN &quot;26&quot; THEN &quot;MO&quot; WHEN &quot;27&quot; THEN &quot;MT&quot; WHEN &quot;28&quot; THEN &quot;NE&quot; WHEN &quot;29&quot; THEN &quot;NV&quot; WHEN &quot;30&quot; THEN &quot;NH&quot; WHEN &quot;31&quot; THEN &quot;NJ&quot; WHEN &quot;32&quot; THEN &quot;NM&quot; WHEN &quot;33&quot; THEN &quot;NY&quot; WHEN &quot;34&quot; THEN &quot;NC&quot; WHEN &quot;35&quot; THEN &quot;ND&quot; WHEN &quot;36&quot; THEN &quot;OH&quot; WHEN &quot;37&quot; THEN &quot;OK&quot; WHEN &quot;38&quot; THEN &quot;OR&quot; WHEN &quot;39&quot; THEN &quot;PA&quot; WHEN &quot;40&quot; THEN &quot;PR&quot; WHEN &quot;41&quot; THEN &quot;RI&quot; WHEN &quot;42&quot; THEN &quot;SC&quot; WHEN &quot;43&quot; THEN &quot;SD&quot; WHEN &quot;44&quot; THEN &quot;TN&quot; WHEN &quot;45&quot; THEN &quot;TX&quot; WHEN &quot;46&quot; THEN &quot;UT&quot; WHEN &quot;47&quot; THEN &quot;VT&quot; WHEN &quot;48&quot; THEN &quot;VI&quot; WHEN &quot;49&quot; THEN &quot;VA&quot; WHEN &quot;50&quot; THEN &quot;WA&quot; WHEN &quot;51&quot; THEN &quot;WV&quot; WHEN &quot;52&quot; THEN &quot;WI&quot; WHEN &quot;53&quot; THEN &quot;WY&quot; END)' />
            </column>
            <column caption='Cut needed for chosen condition' datatype='real' default-format='p0.0%' name='[Calculation_3827472772031086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [counts_toward_penalty] AND ([Parameters].[Parameter 1] = &quot;All conditions&quot; OR [condition] = [Parameters].[Parameter 1])&#13;&#10;THEN [reduction_needed_to_clear] END' />
            </column>
            <column caption='Median cut that ends the penalty' datatype='real' default-format='p0.0%' name='[Calculation_4830375413761681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1] = &quot;All conditions&quot;,&#13;&#10;    MEDIAN(IF [Calculation_5759220639618091] AND [Calculation_1849786399782356] THEN [Calculation_9488607057292462] END),&#13;&#10;    MEDIAN(IF [Calculation_5759220639618091] THEN [Calculation_3827472772031086] END))' />
            </column>
