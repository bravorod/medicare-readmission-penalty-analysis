            </column>
            <column caption='Penalty $ after cut' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[Calculation_6047587985194568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1849786399782356] THEN [Calculation_9802025575295742] * [hospital_medicare_payments_usd] END' />
            </column>
            <column caption='Cut applied' datatype='real' default-format='p0%' name='[Calculation_8232376009799434]' role='measure' type='quantitative'>
