      <column caption='Where savings stop' datatype='string' name='[Calculation_2086835893140252]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD(IF [Calculation_5759220639618091] THEN [facility_id] END) = 1 THEN&#13;&#10;    IF ISNULL(MAX(IF [Calculation_5759220639618091] AND [counts_toward_penalty] THEN 1 END)) THEN&#13;&#10;        &quot;This hospital has no readmission penalty, so the slider can&apos;t change anything.&quot;&#13;&#10;    ELSEIF ISNULL(MAX(IF [Calculation_5759220639618091] THEN [Calculation_3827472772031086] END)) THEN&#13;&#10;        [Parameters].[Parameter 1] + &quot; isn&apos;t part of this hospital&apos;s penalty, so the slider can&apos;t change it.&quot;&#13;&#10;    ELSE &quot;Savings stop at &quot; + STR(INT(CEILING(MAX(IF [Calculation_5759220639618091] THEN [Calculation_3827472772031086] END) * 100)))&#13;&#10;        + &quot;%. That cut ends this hospital&apos;s &quot; + ATTR([Calculation_9763411699565876]) + &quot; penalty, so going higher won&apos;t change anything.&quot;&#13;&#10;    END&#13;&#10;ELSEIF ISNULL(MAX(IF [Calculation_5759220639618091] AND [counts_toward_penalty] THEN 1 END)) THEN&#13;&#10;    &quot;None of these hospitals are penalized, so the slider can&apos;t change anything.&quot;&#13;&#10;ELSEIF ISNULL([Calculation_4830375413761681]) THEN&#13;&#10;    &quot;None of these hospitals are penalized for &quot; + ATTR([Calculation_9763411699565876]) + &quot;.&quot;&#13;&#10;ELSEIF [Calculation_2191898791070076] = 1 THEN&#13;&#10;    &quot;Only one of these hospitals is penalized&quot;&#13;&#10;    + IIF([Parameters].[Parameter 1] = &quot;All conditions&quot;, &quot;&quot;, &quot; for &quot; + ATTR([Calculation_9763411699565876]))&#13;&#10;    + &quot;, and a cut of &quot; + STR(INT(CEILING([Calculation_4830375413761681] * 100))) + &quot;% ends &quot;&#13;&#10;    + IIF([Parameters].[Parameter 1] = &quot;All conditions&quot;, &quot;it.&quot;, &quot;that penalty.&quot;)&#13;&#10;ELSE IIF([Parameters].[Parameter 1] = &quot;All conditions&quot;, &quot;Half of the penalized hospitals end their whole penalty&quot;,&#13;&#10;          &quot;Half of the hospitals penalized for &quot; + ATTR([Calculation_9763411699565876]) + &quot; end that penalty&quot;)&#13;&#10;    + &quot; with a cut of &quot; + STR(INT(CEILING([Calculation_4830375413761681] * 100))) + &quot;% or less.&quot;&#13;&#10;END' />
