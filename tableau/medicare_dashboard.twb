t; THEN [Parameters].[Parameter 410]&#13;&#10;WHEN &quot;VA|FREDERICKSBURG&quot; THEN [Parameters].[Parameter 411]&#13;&#10;WHEN &quot;VA|NEWPORT NEWS&quot; THEN [Parameters].[Parameter 412]&#13;&#10;WHEN &quot;VA|NORFOLK&quot; THEN [Parameters].[Parameter 413]&#13;&#10;WHEN &quot;VA|RICHMOND&quot; THEN [Parameters].[Parameter 414]&#13;&#10;WHEN &quot;VA|VIRGINIA BEACH&quot; THEN [Parameters].[Parameter 415]&#13;&#10;WHEN &quot;VA|WILLIAMSBURG&quot; THEN [Parameters].[Parameter 416]&#13;&#10;WHEN &quot;WA|OLYMPIA&quot; THEN [Parameters].[Parameter 417]&#13;&#10;WHEN &quot;WA|SEATTLE&quot; THEN [Parameters].[Parameter 418]&#13;&#10;WHEN &quot;WA|SPOKANE&quot; THEN [Parameters].[Parameter 419]&#13;&#10;WHEN &quot;WA|TACOMA&quot; THEN [Parameters].[Parameter 420]&#13;&#10;WHEN &quot;WA|VANCOUVER&quot; THEN [Parameters].[Parameter 421]&#13;&#10;WHEN &quot;WI|APPLETON&quot; THEN [Parameters].[Parameter 422]&#13;&#10;WHEN &quot;WI|EAU CLAIRE&quot; THEN [Parameters].[Parameter 423]&#13;&#10;WHEN &quot;WI|GREEN BAY&quot; THEN [Parameters].[Parameter 424]&#13;&#10;WHEN &quot;WI|JANESVILLE&quot; THEN [Parameters].[Parameter 425]&#13;&#10;WHEN &quot;WI|KENOSHA&quot; THEN [Parameters].[Parameter 426]&#13;&#10;WHEN &quot;WI|LA CROSSE&quot; THEN [Parameters].[Parameter 427]&#13;&#10;WHEN &quot;WI|MADISON&quot; THEN [Parameters].[Parameter 428]&#13;&#10;WHEN &quot;WI|MENOMONEE FALLS&quot; THEN [Parameters].[Parameter 429]&#13;&#10;WHEN &quot;WI|MILWAUKEE&quot; THEN [Parameters].[Parameter 430]&#13;&#10;WHEN &quot;WI|SHEBOYGAN&quot; THEN [Parameters].[Parameter 431]&#13;&#10;WHEN &quot;WI|STEVENS POINT&quot; THEN [Parameters].[Parameter 432]&#13;&#10;WHEN &quot;WV|BECKLEY&quot; THEN [Parameters].[Parameter 433]&#13;&#10;WHEN &quot;WV|CHARLESTON&quot; THEN [Parameters].[Parameter 434]&#13;&#10;WHEN &quot;WV|HUNTINGTON&quot; THEN [Parameters].[Parameter 435]&#13;&#10;WHEN &quot;WV|MORGANTOWN&quot; THEN [Parameters].[Parameter 436]&#13;&#10;WHEN &quot;WY|CASPER&quot; THEN [Parameters].[Parameter 437]&#13;&#10;ELSE &quot;All hospitals&quot;&#13;&#10;END' />
            </column>
            <column caption='In what-if view' datatype='boolean' name='[Calculation_5759220639618091]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_3197067015487477]&#13;&#10;AND ([Calculation_9138364361968688] = &quot;All cities&quot; OR [city] = [Calculation_9138364361968688])&#13;&#10;AND ([Calculation_5703706460212452] = &quot;All hospitals&quot; OR [facility_id] = [Calculation_5703706460212452])' />
            </column>
            <column caption='Penalty $ after cut' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[Calculation_6047587985194568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1849786399782356] THEN [Calculation_9802025575295742] * [hospital_medicare_payments_usd] END' />
            </column>
            <column caption='Penalty $ saved' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[Calculation_6128979408024740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(SUM([Calculation_1115009490449795]) - SUM([Calculation_6047587985194568]), 0)' />
            </column>
            <column caption='Share of penalty saved' datatype='real' default-format='p0%' name='[Calculation_6617884208463837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6128979408024740] / SUM([Calculation_1115009490449795])' />
            </column>
            <column caption='Money kept (text)' datatype='string' name='[Calculation_7889420245407051]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_6128979408024740]) THEN &quot;n/a&quot;&#13;&#10;ELSEIF [Calculation_6128979408024740] &gt;= 999500 THEN &quot;$&quot; + STR(DIV(INT(ROUND([Calculation_6128979408024740] / 100000, 0)), 10)) + &quot;.&quot; + STR(INT(ROUND([Calculation_6128979408024740] / 100000, 0)) % 10) + &quot;M&quot;&#13;&#10;ELSEIF [Calculation_6128979408024740] &gt;= 500 THEN &quot;$&quot; + STR(INT(ROUND([Calculation_6128979408024740] / 1000, 0))) + &quot;K&quot;&#13;&#10;ELSE &quot;$&quot; + STR(INT(ROUND([Calculation_6128979408024740], 0)))&#13;&#10;END' />
            </column>
            <column caption='Cut applied' datatype='real' default-format='p0%' name='[Calculation_8232376009799434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;All conditions&quot; OR [condition] = [Parameters].[Parameter 1]&#13;&#10;THEN [Parameters].[Parameter 2] / 100&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Hospitals helped' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_9033902446369652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1849786399782356] AND [Calculation_9802025575295742] &lt; [Calculation_3845773524162689] - 0.0000001&#13;&#10;    THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Chosen city' datatype='string' name='[Calculation_9138364361968688]' role='dimension' type='nominal'>
