            <column caption='Has payment data' datatype='boolean' name='[Calculation_9153621850123208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([hospital_medicare_payments_usd])' />
            </column>
            <column caption='Condition in a sentence' datatype='string' name='[Calculation_9763411699565876]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Pneumonia&quot; THEN &quot;pneumonia&quot; WHEN &quot;Heart failure&quot; THEN &quot;heart failure&quot;&#13;&#10;WHEN &quot;Heart attack&quot; THEN &quot;heart attack&quot; WHEN &quot;COPD&quot; THEN &quot;COPD&quot;&#13;&#10;WHEN &quot;Heart bypass surgery (CABG)&quot; THEN &quot;heart bypass (CABG)&quot;&#13;&#10;WHEN &quot;Hip/knee replacement&quot; THEN &quot;hip/knee replacement&quot; ELSE &quot;whole&quot; END' />
            </column>
