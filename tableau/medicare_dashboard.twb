            <zone fixed-size='64' forceUpdate='true' h='6261' id='3' is-fixed='true' type-v2='text' w='98666' x='667' y='696'>
              <formatted-text>
                <run fontcolor='#1f1f1f' fontname='Tableau Bold' fontsize='17'>Medicare&apos;s readmission penalty costs hospitals about $377M a year</run>
                <run>Æ&#10;</run>
                <run fontsize='10'>Medicare cuts payments to hospitals when too many patients come back within 30 days  ·  CMS data, fiscal year 2026  ·  Rodrigo Bravo  ·  </run>
                <run fontcolor='#2a78d6' fontname='Tableau Medium' fontsize='10'>Try the simulator below</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='padding' value='4' />
