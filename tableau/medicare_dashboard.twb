#13;&#10;WHEN &quot;NM&quot; THEN [Parameters].[Parameter 35]&#13;&#10;WHEN &quot;NV&quot; THEN [Parameters].[Parameter 36]&#13;&#10;WHEN &quot;NY&quot; THEN [Parameters].[Parameter 37]&#13;&#10;WHEN &quot;OH&quot; THEN [Parameters].[Parameter 38]&#13;&#10;WHEN &quot;OK&quot; THEN [Parameters].[Parameter 39]&#13;&#10;WHEN &quot;OR&quot; THEN [Parameters].[Parameter 40]&#13;&#10;WHEN &quot;PA&quot; THEN [Parameters].[Parameter 41]&#13;&#10;WHEN &quot;RI&quot; THEN [Parameters].[Parameter 42]&#13;&#10;WHEN &quot;SC&quot; THEN [Parameters].[Parameter 43]&#13;&#10;WHEN &quot;SD&quot; THEN [Parameters].[Parameter 44]&#13;&#10;WHEN &quot;TN&quot; THEN [Parameters].[Parameter 45]&#13;&#10;WHEN &quot;TX&quot; THEN [Parameters].[Parameter 46]&#13;&#10;WHEN &quot;UT&quot; THEN [Parameters].[Parameter 47]&#13;&#10;WHEN &quot;VA&quot; THEN [Parameters].[Parameter 48]&#13;&#10;WHEN &quot;VT&quot; THEN [Parameters].[Parameter 49]&#13;&#10;WHEN &quot;WA&quot; THEN [Parameters].[Parameter 50]&#13;&#10;WHEN &quot;WI&quot; THEN [Parameters].[Parameter 51]&#13;&#10;WHEN &quot;WV&quot; THEN [Parameters].[Parameter 52]&#13;&#10;WHEN &quot;WY&quot; THEN [Parameters].[Parameter 53]&#13;&#10;ELSE &quot;All cities&quot;&#13;&#10;END' />
